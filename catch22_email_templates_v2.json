  "mailer_templates_recovery_content": "<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#0F172A;font-family:-apple-system,BlinkMacSystemFont,sans-serif;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding:40px 20px;\"><tr><td align=\"center\"><table width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#0A472E;border-radius:16px;overflow:hidden;max-width:560px;width:100%;\"><tr><td style=\"padding:40px;text-align:center;border-bottom:1px solid rgba(209,255,0,0.2);\"><img src=\"https://wcoaqlglwxwceqktpckt.supabase.co/storage/v1/object/public/media/wp-content/uploads/2021/10/logo.png\" alt=\"Catch-22\" width=\"200\" style=\"display:block;margin:0 auto;\" /></td></tr><tr><td style=\"padding:40px;\"><h1 style=\"margin:0 0 16px;color:#ffffff;font-size:24px;font-weight:900;text-transform:uppercase;letter-spacing:0.05em;\">Reset Your Password</h1><p style=\"margin:0 0 32px;color:rgba(255,255,255,0.75);font-size:15px;line-height:1.6;\">We received a request to reset your Catch-22 password. Click below to choose a new one. This link expires in 1 hour.</p><table cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tr><td align=\"center\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#D1FF00;color:#0A472E;font-weight:900;font-size:13px;text-transform:uppercase;letter-spacing:0.2em;text-decoration:none;padding:16px 40px;border-radius:9999px;\">Reset My Password</a></td></tr></table><p style=\"margin:32px 0 0;color:rgba(255,255,255,0.4);font-size:12px;text-align:center;\">If you did not request a reset, your account is safe. You can ignore this email.</p></td></tr><tr><td style=\"padding:24px 40px;border-top:1px solid rgba(209,255,0,0.2);text-align:center;\"><p style=\"margin:0;color:rgba(255,255,255,0.4);font-size:11px;text-transform:uppercase;letter-spacing:0.15em;\">Catch-22 &middot; Premium Fishing Gear &middot; New Zealand</p><p style=\"margin:8px 0 0;color:rgba(255,255,255,0.25);font-size:11px;\">2.5% of all profits donated to NZ Sea Cleaners Charity Trust</p></td></tr></table></td></tr></table></body></html>",
  "mailer_templates_invite_content": "<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#0F172A;font-family:-apple-system,BlinkMacSystemFont,sans-serif;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding:40px 20px;\"><tr><td align=\"center\"><table width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#0A472E;border-radius:16px;overflow:hidden;max-width:560px;width:100%;\"><tr><td style=\"padding:40px;text-align:center;border-bottom:1px solid rgba(209,255,0,0.2);\"><img src=\"https://wcoaqlglwxwceqktpckt.supabase.co/storage/v1/object/public/media/wp-content/uploads/2021/10/logo.png\" alt=\"Catch-22\" width=\"200\" style=\"display:block;margin:0 auto;\" /></td></tr><tr><td style=\"padding:40px;\"><h1 style=\"margin:0 0 16px;color:#ffffff;font-size:24px;font-weight:900;text-transform:uppercase;letter-spacing:0.05em;\">You Have Been Invited</h1><p style=\"margin:0 0 32px;color:rgba(255,255,255,0.75);font-size:15px;line-height:1.6;\">You have been invited to join Catch-22. Click the button below to accept your invitation and create your account.</p><table cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tr><td align=\"center\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#D1FF00;color:#0A472E;font-weight:900;font-size:13px;text-transform:uppercase;letter-spacing:0.2em;text-decoration:none;padding:16px 40px;border-radius:9999px;\">Accept Invitation</a></td></tr></table><p style=\"margin:32px 0 0;color:rgba(255,255,255,0.4);font-size:12px;text-align:center;\">If you were not expecting this invitation, you can safely ignore this email.</p></td></tr><tr><td style=\"padding:24px 40px;border-top:1px solid rgba(209,255,0,0.2);text-align:center;\"><p style=\"margin:0;color:rgba(255,255,255,0.4);font-size:11px;text-transform:uppercase;letter-spacing:0.15em;\">Catch-22 &middot; Premium Fishing Gear &middot; New Zealand</p><p style=\"margin:8px 0 0;color:rgba(255,255,255,0.25);font-size:11px;\">2.5% of all profits donated to NZ Sea Cleaners Charity Trust</p></td></tr></table></td></tr></table></body></html>"
