{
  "name": "indivisible-fairoaks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "test -d .git && lefthook install || true",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint --write ./src && oxlint ./src",
    "lint:check": "biome lint ./src && oxlint ./src",
    "typecheck:edge": "deno check --node-modules-dir=auto --no-lock supabase/functions/*/index.ts",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "check": "biome check --write ./src",
    "check:ci": "biome ci ./src",
    "test": "bun vitest --run",
    "test:e2e": "playwright test",
    "test:watch": "bun vitest",
    "test:coverage": "bun vitest run --coverage",
    "types:generate": "node scripts/gen-types.mjs",
    "secrets:audit": "node scripts/secrets-audit.mjs",
    "secrets:baseline": "node scripts/secrets-audit.mjs --update-baseline",
    "auth:check": "node scripts/check-auth-redirects.mjs --live",
    "vercel:env:sync": "node scripts/sync-vercel-env.mjs",
    "snap": "node scripts/snap.mjs",
    "palette": "node scripts/palette.mjs",
    "token-sweep": "node scripts/token-sweep.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^11.4.0",
    "@stripe/react-stripe-js": "^6.9.0",
    "@stripe/stripe-js": "^9.15.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "effect": "^3.22.1",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "next": "16.3.2",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "sonner": "^2.0.8",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.6.0",
    "vgpu": "^0.4.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.12",
    "@next/playwright": "^16.3.4",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "oxlint": "^1.81.0",
    "playwright": "1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vercel": "^59.11.7",
    "vitest": "^5.0.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.4.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "ws": "8.21.3",
    "sharp": "0.35.3",
    "tar": "7.5.22"
  }
