    },
    "@vercel/python-analysis": {
      "minimatch": "10.2.6"
    },
    "@vercel/backends": {
      "path-to-regexp": "8.4.2"
    },
    "@vercel/express": {
      "path-to-regexp": "8.4.2"
    },
    "@vercel/hono": {
      "path-to-regexp": "8.4.2"
    },
    "@vercel/fun": {
      "path-to-regexp": "8.4.2"
    },
    "@vercel/node": {
      "path-to-regexp": "6.3.0",
      "undici": "6.28.1"
    },
    "@vercel/remix-builder": {
      "path-to-regexp": "6.3.0"
    },
    "vercel": {
      "undici": "6.28.1"
    }
  }
}
