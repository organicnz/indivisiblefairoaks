{
  "name": "indivisible-fairoaks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "bun scripts/install-hooks.mjs",
    "dev": "bun --bun next dev --turbopack",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun biome lint --write ./src && bun lint ./src",
    "lint:check": "bun --bun biome lint ./src && bun lint ./src",
    "typecheck": "bun --bun tsrs --noEmit",
    "typecheck:watch": "bun --bun tsrs --watch --noEmit",
    "typecheck:stats": "bun --bun tsrs --extendedDiagnostics --noEmit",
    "typecheck:edge": "deno check --config supabase/functions/deno.json --no-lock supabase/functions/*/index.ts",
    "format": "bun --bun biome format --write ./src",
    "format:check": "bun --bun biome format ./src",
    "check:biome": "bun --bun biome check --write ./src",
    "check:ci": "bun --bun biome ci ./src",
    "test": "bun --bun vitest --run",
    "test:e2e": "bun node_modules/@playwright/test/cli.js test",
    "test:watch": "bun --bun vitest",
    "test:coverage": "bun --bun vitest run --coverage",
    "types:generate": "bun scripts/gen-types.mjs",
    "audit:deps": "bun scripts/check-vulnerabilities.mjs",
    "secrets:audit": "bun scripts/secrets-audit.mjs",
    "secrets:baseline": "bun scripts/secrets-audit.mjs --update-baseline",
    "auth:check": "bun scripts/check-auth-redirects.mjs --live",
    "vercel:env:sync": "bun scripts/sync-vercel-env.mjs",
    "snap": "bun scripts/snap.mjs",
    "palette": "bun scripts/palette.mjs",
    "token-sweep": "bun scripts/token-sweep.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^11.9.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "effect": "^3.22.4",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "sonner": "^2.0.8",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0",
    "vgpu": "^0.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.3",
    "@next/playwright": "16.4.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "5.0.5",
    "bun-types": "1.4.4-canary.20261023T141459",
    "fast-check": "^4.10.2",
    "jsdom": "30.0.1",
    "lefthook": "^2.2.2",
    "oxlint": "^1.89.0",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.3",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "file:./tools/typescript-shim",
    "vercel": "^65.2.0",
    "vitest": "5.0.5"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.31",
    "ws": "8.21.3",
    "sharp": "0.35.5",
    "tar": "7.5.22",
    "ajv": "8.20.0",
    "js-yaml": "4.3.2",
    "smol-toml": "1.9.1",
    "vite": "8.3.4",
