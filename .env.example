# Local dev template — copy to .env.local and fill in real values:
#   cp .env.example .env.local
#
# PLACEHOLDERS ONLY — never commit real secrets here. The pre-commit
# no-secrets hook rejects sb_secret_/sb_publishable_/sk_live_/re_ values.
#
# This file is the contract enforced by lefthook:
#   - env-integrity: every key below must exist in your .env.local
#   - env-usage-coverage: every non-public process.env.* in src must be declared here
#
# Prod/edge secrets (Stripe live keys, RESEND_API_KEY, search tuning) are NOT
# local-dev vars — they live in Vercel env + GitHub Secrets and sync to the
# Supabase edge runtime via the supabase.yml workflow. See
# supabase/functions/env.example.md for that contract.

# The canonical origin this build serves. Drives metadataBase, every canonical
# URL, og:url, sitemap.xml and robots.txt — all via src/config/site.ts.
#
# Set this to the apex for production. Any other value (staging, a Vercel preview
# URL) makes the build emit `noindex, nofollow` site-wide, so previews and staging
# can never compete with the apex in search results. See
# docs/apex-cutover-runbook.md.
NEXT_PUBLIC_SITE_URL=https://indivisiblefairoaks.org
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_paste_yours_here
# Publishable Stripe key. Read by StripeExpressCheckout, which the cart renders.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_paste_yours_here
# Sentry error monitoring (indivisiblefairoaks-web project). Public by
# construction — the client SDK ships it in the bundle. Leave this empty
# unless you want local dev errors filed against the project: an empty value
# fails validation into undefined and the SDK stays disabled. Production and
# preview builds read the real DSN from Vercel env; see scripts/vercel-env.mjs.
NEXT_PUBLIC_SENTRY_DSN=
SUPABASE_SECRET_KEY=sb_secret_paste_yours_here
# ── Server-side only, read by the WALL-E Supabase Edge Function ───────────────
# These are EDGE FUNCTION secrets, not app vars — see
# supabase/functions/env.example.md for the full edge contract. They live here so
# `supabase functions serve` picks them up locally.
ZAI_API_KEY=
GROQ_API_KEY=
# Resend email delivery (optional in local dev, active in prod/edge)
RESEND_API_KEY=
# The From address must be on a domain with a published Resend DKIM record, or
# DMARC fails. The apex is verified via `resend._domainkey`; note that the apex
# SPF authorises Google only, so application mail passes on DKIM alignment alone.
# See docs/infrastructure-and-email-recovery-log.md §8.
RESEND_FROM_EMAIL=contact@indivisiblefairoaks.org
ADMIN_ORDER_EMAIL=contact@indivisiblefairoaks.org
